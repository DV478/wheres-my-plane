# Copy to .dev.vars and fill in. Never commit .dev.vars.
# For `wrangler dev` / `wrangler pages dev` local runs.

# Resend — https://resend.com/api-keys (free)
RESEND_API_KEY="re_xxx"

# Sender for magic-link emails.
# No custom domain yet → use Resend's shared test sender.
MAGIC_LINK_FROM="Where's My Plane <onboarding@resend.dev>"

# Public base URL — used to build magic-link callback.
# Dev: http://localhost:5173
# Prod: https://<your-project>.pages.dev
PUBLIC_BASE_URL="http://localhost:5173"

# Random 32-byte hex used for signing session cookies.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET="replace-with-generated-hex"
